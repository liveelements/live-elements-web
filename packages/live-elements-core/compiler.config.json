{
    "baseComponent" : "BaseElement",
    "baseComponentPath" : "live-elements-core/baseelement.js",
    "implicitTypes" : [
        "console", "document", "arguments", "window", "alert", "parseInt", "parseFloat", "undefined", "Error", "Object", "Math", "JSON", "Set", "WeakSet", "Map", "WeakMap", "Array", 
        "String", "Symbol", "Date", "BigInt", "Data", "DataView", "Function", "Generator", "NaN", "Number",
        "Int8Array", "Uint8Array", "Uint8ClampedArray", "Int16Array", "Uint16Array", "Int32Array", "Uint32Array", 
        "Float32Array", "Float64Array", "BigInt64Array", "BigUint64Array", "SharedArrayBuffer", "Atomics", "RegExp",
        "RangeError", "ReferenceError", "SyntaxError", "TypeError", "AsyncFunction", "Promise", "setTimeout", "setInterval", "clearInterval", "clearTimeout", "isNaN",
        "encodeURIComponent", "decodeURIComponent", "encodeURI", "decodeURI"
    ],
    "flowModulePath": "live-elements-flow/shared/flow.mjs",
    "flowModuleName": "Flow",
    "typesModulePath": "live-elements-core/types.mjs",
    "resolveTypesModule": "live-elements-core/compiler/type-resolver.mjs",
    "flowCalls": {
        "create": "Flow.create",
        "call": "Flow.call",
        "return": "Flow.ret",
        "ref": "Flow.ref",
        "member": "Flow.member",
        "function": "Flow.fn"
    },
    "importLocalPath" : "node_modules",
    "packageBuildPath" : "build",
    "outputExtension" : "mjs",
    "outputTarget": "JS_DTS",
    "enableComponentMetaInfo": true,
    "allowUnresolved" : false
}
