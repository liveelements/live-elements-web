import live-elements-web-server.page.index

component WorkspaceCompilation{
    Page page: null
    string pageContent: ''
    string identifier: ''
    Date stamp: null
    Array<WorkspaceAsset> assets: []
    Array<string> errors: []
    Array<string> warnings: []
    Array<string> styles: []
    WorkspaceAsset mainAsset: null
    Object usageAssignments: null
    static fn generateid(){
        return `${Math.random().toString(36).substring(2, 15)}${Date.now().toString(36)}`
    }

    static fn stampToString(stamp:Object):string{
        if ( stamp instanceof Date ){
            return Number.isNaN(stamp.getTime()) ? '' : stamp.toISOString()
        }
        return stamp != null ? String(stamp) : ''
    }

    static fn replaceMessageWorkspacePaths(message:string, workspacePath:string):string{
        return String(message ? message : '')
            .replaceAll(workspacePath + '/', '')
            .replaceAll(workspacePath, '')
    }

    static fn compilationData(compilation:WorkspaceCompilation):Object{
        if ( !compilation ){
            return null
        }
        return {
            identifier: compilation.identifier,
            stamp: WorkspaceCompilation.stampToString(compilation.stamp),
            errors: compilation.errors.map(error => error?.message || String(error))
        }
    }

    static fn createFromErrors(errors:Array<Object>, identifier:string, stamp:Date, workspacePath:string){
        return WorkspaceCompilation{
            errors: errors.map(error => ({
                message: WorkspaceCompilation.replaceMessageWorkspacePaths(error.message, workspacePath)
            }))
            identifier: identifier
            stamp: stamp
        }
    }

    fn hasResult(){
        return this.page ? true : false
    }

    fn hasErrors(){
        return this.errors.length ? true : false
    }

    fn updateStyles(styles:Array<Object>){
        this.styles = styles
    }

    fn findAsset(name:string){
        return this.assets.find(asset => asset.name === name)
    }

    fn findStyle(file:string){
        return this.styles.find(style => style.file === file)
    }

    fn toJSON():Object{
        return {
            id: this.identifier,
            page: 'wsindex.html',
            styles: this.styles.map(style => style.file),
            assets: this.assets.map(asset => asset.name),
            errors: this.errors,
            main: this.mainAsset ? this.mainAsset.name : null,
            usages: this.usageAssignments,
            stamp: WorkspaceCompilation.stampToString(this.stamp)
        }
    }

    static fn fromJSON(data:Object, content:Object = ({})){
        const assets = (data.assets || []).map(name => WorkspaceAsset{
            name: name
            content: content.assets?.[name] || ''
        })

        return WorkspaceCompilation{
            pageContent: content.page || ''
            identifier: data.id
            stamp: data.stamp ? new Date(data.stamp) : null
            assets: assets
            errors: data.errors || []
            mainAsset: assets.find(asset => asset.name === data.main)
            usageAssignments: data.usages
            styles: (data.styles || []).map(file => ({
                file: file,
                content: content.styles?.[file] || ''
            }))
        }
    }
}
