import path from 'path'
import .lib.middle

component Workspace{
    static string dataFile = 'workspace.json'
    static Object WriteBehavior = {
        ReadOnly: 0,
        Write: 1,
        Fork: 2
    }

    constructor(){
        super()
        this{}
        this._path = ''
        this._name = ''
        this._createdOn = null
        this._mainEntry = ''
        this._mainEntryData = null
        this._serverStub = null
        this._from = ''
        this._writeBehavior = Workspace.WriteBehavior.Write
        this._canFork = true
        this._author = null
        this._documents = []
        this._compilation = null
    }

    get path(){ return this._path }
    get name(){ return this._name }
    get createdOn(){ return this._createdOn }
    get mainEntry(){ return this._mainEntry }
    get mainEntryData(){ return this._mainEntryData }
    get serverStub(){ return this._serverStub }
    get mainEntryPath(){ return path.join(this._path, this._mainEntry) }
    get documents(){ return this._documents }
    get canFork(){ return this._canFork }
    get author(){ return this._author }
    get writeBehavior(){ return this._writeBehavior }
    get compilation(){ return this._compilation }

    set compilation(value:Object){
        this._compilation = value ? value : null
    }

    set writeBehavior(value:number){
        if ( value >= 3 ){
            throw new Error(`Value ${value} does not represent a write behavior`)
        }
        this._writeBehavior = value
    }

    fn canWrite(){
        return this._writeBehavior === Workspace.WriteBehavior.Write
    }

    fn workspaceData(compilation:WorkspaceCompilation):Object{
        return {
            name: this.name,
            documents: this.documents,
            entry: this.mainEntry,
            entryData: this.mainEntryData,
            serverStub: this.serverStub,
            writeBehavior: this.writeBehavior,
            compilation: WorkspaceCompilation.compilationData(compilation)
        }
    }

    fn toJSON():Object{
        return {
            name: this._name,
            entry: this._mainEntry,
            entryData: this._mainEntryData,
            serverStub: this._serverStub,
            from: this._from,
            writeBehavior: this._writeBehavior,
            canFork: this._canFork,
            author: this._author,
            documents: this._documents.map(document => ({ path: document.path, type: document.type })),
            compilation: this._compilation,
            createdOn: this._createdOn ? this._createdOn.toISOString() : null
        }
    }

    static fn fromJSON(data:Object, workspacePath:string, documentContents:Object = ({})):Workspace{
        const ws = Workspace{}
        ws._path = workspacePath
        ws._name = data.name || ''
        ws._createdOn = data.createdOn ? new Date(data.createdOn) : null
        ws._mainEntry = data.entry || ''
        ws._mainEntryData = data.entryData || null
        ws._serverStub = data.serverStub || null
        ws._from = data.from || ''
        ws._writeBehavior = data.writeBehavior != null ? data.writeBehavior : Workspace.WriteBehavior.Write
        ws._canFork = data.canFork != null ? data.canFork : true
        ws._author = data.author || null
        ws._compilation = data.compilation || null
        ws._documents = (data.documents || []).map(document => {
            const content = documentContents[document.path] || ''
            return Document{
                path: document.path
                type: document.type
                content: content
            }
        })
        return ws
    }

    static fn create(name:string, workspacePath:string, mainEntry:string, author:string):Workspace{
        const ws = Workspace{}
        ws._path = workspacePath
        ws._name = name
        ws._createdOn = new Date()
        ws._mainEntry = mainEntry
        ws._author = author || null
        return ws
    }

    static fn generateName(){
        const randomPrefix = Math.random().toString(36).substring(2, 15)
        const timestamp = Date.now().toString(36)
        const randomSuffix = Math.random().toString(36).substring(2, 15)
        return `${randomPrefix}-${timestamp}-${randomSuffix}`
    }

    fn isDocumentOpened(filePath:string){
        return this._documents.find(document => document.path === filePath)
    }

    fn openDocument(filePath:string, userType:string, content:string = ''){
        const existing = this.isDocumentOpened(filePath)
        if ( existing ){
            return existing
        }

        const ext = path.parse(filePath).ext
        const document = Document{
            path: filePath
            type: userType ? userType : ext.substring(ext.indexOf('.'))
            content: content
        }
        this._documents.push(document)
        return document
    }
}
