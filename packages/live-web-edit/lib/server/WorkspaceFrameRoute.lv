import live-elements-web-server.router

import APIRoute from 'live-elements-web-server/lib/core/api-route.mjs'

component WorkspaceFrameRoute < Route{
    id: workspaceFrameRoute

    WorkspaceStorage storage: null
    WorkspaceCompiler compiler: null
    string baseUrl = ''

    fn handlerContext(){
        return {
            storage: this.storage,
            compiler: this.compiler,
            baseUrl: this.baseUrl || this.url
        }
    }

    GetRoute{
        url: '/v/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceFrameRoute.handlerContext(),
            handler: (input, context) => workspaceRouteFrameHandlers.page(input, context)
        })
    }

    GetRoute{
        url: '/v-scripts/:wsname/ws.bundle.js'
        f: APIRoute.wrap({
            context: (_req) => workspaceFrameRoute.handlerContext(),
            handler: (input, context) => workspaceRouteFrameHandlers.mainScript(input, context)
        })
    }

    GetRoute{
        url: '/v-scripts/:wsname/:scriptid'
        f: APIRoute.wrap({
            context: (_req) => workspaceFrameRoute.handlerContext(),
            handler: (input, context) => workspaceRouteFrameHandlers.script(input, context)
        })
    }

    PostRoute{
        url: '/v-use/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceFrameRoute.handlerContext(),
            handler: (input, context) => workspaceRouteFrameHandlers.use(input, context)
        })
    }

    GetRoute{
        url: '/v/:wsname/styles/:styleid'
        f: APIRoute.wrap({
            context: (_req) => workspaceFrameRoute.handlerContext(),
            handler: (input, context) => workspaceRouteFrameHandlers.style(input, context)
        })
    }
}
