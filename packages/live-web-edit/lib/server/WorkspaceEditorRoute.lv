import live-elements-web-server.router

import APIRoute from 'live-elements-web-server/lib/core/api-route.mjs'
import { RequestError } from 'live-elements-web-server/shared/errors/request-error.mjs'

component WorkspaceEditorRoute < Route{
    id: workspaceEditorRoute

    WorkspaceStorage storage: null
    WorkspaceCompiler compiler: null
    string baseUrl = ''
    string defaultProject = 'page'
    Object view = null
    Object placement
    Object viewsEnabled = true
    Array<Object> templates = []
    boolean forkOnLoad = false

    constructor(storage:WorkspaceStorage = null, compiler:WorkspaceCompiler = null, baseUrl:string = ''){
        super()
        this{}
        this.storage = storage
        this.compiler = compiler
        this.baseUrl = baseUrl
    }

    fn handlerContext(){
        return {
            storage: this.storage,
            compiler: this.compiler,
            baseUrl: this.baseUrl || this.url,
            templates: this.templates,
            defaultProject: this.defaultProject
        }
    }

    fn error(e:Object, req:Object){
        console.error(RequestError.wrap(req, e.internal || e).toString())
    }

    Route{
        children: workspaceEditorRoute.viewsEnabled ? [
            ViewRoute{
                url: '/'
                c: workspaceEditorRoute.view
                placement: workspaceEditorRoute.placement
                data: (_req, _res) => ({
                    baseUrl: workspaceEditorRoute.baseUrl || workspaceEditorRoute.url,
                    templates: workspaceEditorRoute.templates.map(template => ({
                        name: template.name,
                        label: template.label,
                        section: template.section
                    })),
                    name: '-'
                })
            },
            ViewRoute{
                url: '/w/:wsname'
                c: workspaceEditorRoute.view
                placement: workspaceEditorRoute.placement
                data: async (req, _res) => {
                    try{
                        const ws = await workspaceEditorRoute.storage.loadWorkspace(req.params.wsname)
                        if ( workspaceEditorRoute.forkOnLoad && ws.writeBehavior === Workspace.WriteBehavior.Write ){
                            ws.writeBehavior = Workspace.WriteBehavior.Fork
                        }

                        const data = ws.workspaceData(
                            await workspaceEditorRoute.storage.loadCompilation(ws)
                        )
                        data.baseUrl = workspaceEditorRoute.baseUrl || workspaceEditorRoute.url
                        data.templates = workspaceEditorRoute.templates.map(template => ({
                            name: template.name,
                            label: template.label,
                            section: template.section
                        }))
                        return data
                    } catch ( e ){
                        return { error: e.message }
                    }
                }
            }
        ] : []
    }

    GetRoute{
        url: '/w-load/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceEditorRoute.handlerContext(),
            handler: (input, context) => workspaceRouteEditHandlers.load(input, context),
            error: (e, req) => workspaceEditorRoute.error(e, req)
        })
    }

    GetRoute{
        url: '/w-documents/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceEditorRoute.handlerContext(),
            handler: (input, context) => workspaceRouteEditHandlers.documents(input, context),
            error: (e, req) => workspaceEditorRoute.error(e, req)
        })
    }

    PostRoute{
        url: '/w-fork/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceEditorRoute.handlerContext(),
            handler: (input, context) => workspaceRouteEditHandlers.fork(input, context),
            error: (e, req) => workspaceEditorRoute.error(e, req)
        })
    }

    PostRoute{
        url: '/w-document/save/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceEditorRoute.handlerContext(),
            handler: (input, context) => workspaceRouteEditHandlers.save(input, context),
            error: (e, req) => workspaceEditorRoute.error(e, req)
        })
    }

    PostRoute{
        url: '/w-compile/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceEditorRoute.handlerContext(),
            handler: (input, context) => workspaceRouteEditHandlers.compile(input, context),
            error: (e, req) => workspaceEditorRoute.error(e, req)
        })
    }

    PostRoute{
        url: '/w-lockwrite/:wsname'
        f: APIRoute.wrap({
            context: (_req) => workspaceEditorRoute.handlerContext(),
            handler: (input, context) => workspaceRouteEditHandlers.lockWrite(input, context),
            error: (e, req) => workspaceEditorRoute.error(e, req)
        })
    }
}
