import live-elements-web-server.router

import PackagePath from 'live-elements-web-server/lib/package-path.cjs'
import path from 'path'
import fs from 'fs'

component WorkspaceRoute < Route{
    id: workspaceRoute

    WorkspaceStorage storage: null
    WorkspaceCompiler compiler: null
    string workspacesPath = ''
    string templatesPath = ''
    string defaultProject = 'page'
    string baseUrl = ''
    Object view = null
    Object placement
    Object viewsEnabled = true
    Array<Object> templates = []
    boolean forkOnLoad = false

    constructor(workspacesPath:string, templates:Array<Object>, storage:WorkspaceStorage = null, compiler:WorkspaceCompiler = null){
        super()
        this{}
        this.workspacesPath = workspacesPath
        this.templatesPath = path.join(
            PackagePath.find('live-web-edit', path.resolve('.')),
            'resources',
            'templates'
        )
        this.templates = templates
        this.storage = storage || CachedWorkspaceStorage.create(
            FileWorkspaceStorage.create(workspacesPath, this.templatesPath)
        )
        this.compiler = compiler || PageWorkspaceCompiler.create()
    }

    static fn findWorkspacesIn(lookupDir:string){
        if ( !fs.existsSync(lookupDir) ){
            return []
        }

        return fs.readdirSync(lookupDir)
            .filter(file => {
                const fullPath = path.join(lookupDir, file)
                return fs.lstatSync(fullPath).isDirectory()
                    && fs.existsSync(path.join(fullPath, 'workspace.json'))
            })
            .map(name => {
                const fullPath = path.join(lookupDir, name)
                const json = JSON.parse(fs.readFileSync(path.join(fullPath, 'workspace.json'), 'utf8'))
                return {
                    path: fullPath,
                    name: json.name,
                    section: json.section,
                    label: json.label || json.name
                }
            })
    }

    WorkspaceEditorRoute{
        storage: workspaceRoute.storage
        compiler: workspaceRoute.compiler
        baseUrl: workspaceRoute.baseUrl
        defaultProject: workspaceRoute.defaultProject
        view: workspaceRoute.view
        placement: workspaceRoute.placement
        viewsEnabled: workspaceRoute.viewsEnabled
        templates: workspaceRoute.templates
        forkOnLoad: workspaceRoute.forkOnLoad
    }

    WorkspaceFrameRoute{
        storage: workspaceRoute.storage
        compiler: workspaceRoute.compiler
        baseUrl: workspaceRoute.baseUrl
    }
}
