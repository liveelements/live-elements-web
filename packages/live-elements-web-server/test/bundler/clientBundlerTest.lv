    }

    Scenario{
        name: 'a write to a watched lv source rebuilds the served asset'
        run: async (expect) => {
            const fixture = clientBundlerTest.extractFixtures(['bundler-lv-graph'])
            const packageDir = path.join(fixture.root, 'bundler-lv-graph')
            const entryPath = path.join(packageDir, 'Entry.lv')
            const markerPath = path.join(packageDir, 'lib', 'Marker.lv')
            const watcher = Watcher.createFromGroups(['client-bundler', 'client-bundler-manual'])
            const bundler = await ClientBundler.createAndBuild(
                [ClientBundler.FileEntry.create('main', [entryPath])],
                ClientBundler.Config.create({
                    outputPath: path.join(packageDir, 'dist'),
                    workingDir: packageDir,
                    sourcemap: false,
                    execution: ClientBundler.Config.Execution.Incremental
                })
            )

            try {
                const markerSource = "@fn marker(): string{\n    return 'marker:WATCHED'\n}\n"
                fs.writeFileSync(markerPath, markerSource)
                await bundler.rebuild()

                const context = { window: {}, console, setTimeout, clearTimeout }
                vm.runInNewContext(bundler.currentRun.result.assetFor('main.bundle.js').content, context)
                expect(context.window.__probe__).toEqual(['marker:WATCHED'])
            } finally {
                await bundler.dispose()
                watcher.close()
                fs.rmSync(fixture.root, { recursive: true, force: true })
            }
        }
    }

    Scenario{
        name: 'writeModule content reaches the output of a later rebuild'
        run: async (expect) => {
            const root = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'client-bundler-write-module-')))
            const modulePath = path.join(root, 'main.mjs')
            const outputPath = path.join(root, 'dist')

            try {
                const bundler = await ClientBundler.createAndBuild(
                    [ClientBundler.FileEntry.create('main', [{ path: modulePath, content: "window.__probe__ = 'probe-one'\n" }])],
                    ClientBundler.Config.create({
                        outputPath,
                        workingDir: root,
                        sourcemap: false
                    })
                )

                expect(bundler.currentRun.result.assetFor('main.bundle.js').content).toContain('probe-one')

                bundler.writeModule(modulePath, "window.__probe__ = 'probe-two'\n")
                await bundler.rebuild()

                const rebuilt = bundler.currentRun.result.assetFor('main.bundle.js')
                expect(rebuilt.content).toContain('probe-two')
                expect(rebuilt.content).not.toContain('probe-one')
            } finally {
                fs.rmSync(root, { recursive: true, force: true })
            }
        }
    }

    Scenario{
        name: 'incremental by-package builds still rediscover a package on run 2'
        run: async (expect) => {
            const fixture = clientBundlerTest.extractFixtures(['bundler-by-package-a'])
            const root = fixture.root
            const entryPath = path.join(root, 'main.mjs')
            const outputPath = path.join(root, 'dist')

            try {
                const bundler = await ClientBundler.createAndBuild(
                    [ClientBundler.FileEntry.create('main', [entryPath])],
                    ClientBundler.Config.create({
                        outputPath: outputPath,
                        workingDir: root,
                        sourcemap: false,
                        format: ClientBundler.Config.Format.ModuleSplit,
                        bundling: ClientBundler.Config.Bundling.ByPackage,
                        execution: ClientBundler.Config.Execution.Incremental
                    })
                )

                try {
                    expect(bundler.currentRun.packageList().map((entry) => entry.packageName)).toEqual(['@pkg/a'])

                    await bundler.rebuild()

                    expect(bundler.currentRun.result.externalImports).toEqual(['@pkg/a'])
                    const packages = bundler.currentRun.packageList()
                    expect(packages.map((entry) => entry.packageName)).toEqual(['@pkg/a'])
                    expect(bundler.currentRun.result.assets.find((asset) => asset.path === packages[0].bundleAbsolutePath)?.content).toContain('packageValue')
                } finally {
                    await bundler.dispose()
                }
            } finally {
                fs.rmSync(root, { recursive: true, force: true })
            }
        }
    }

    Scenario{
        name: 'a failed rebuild leaves the previous build intact and the next one succeeds'
        run: async (expect) => {
            const fixture = clientBundlerTest.extractFixtures(['bundler-lv-graph'])
            const packageDir = path.join(fixture.root, 'bundler-lv-graph')
            const entryPath = path.join(packageDir, 'Entry.lv')
            const markerPath = path.join(packageDir, 'lib', 'Marker.lv')
            const outputPath = path.join(packageDir, 'dist')
            const markerSource = fs.readFileSync(markerPath, 'utf8')

            try {
                const bundler = await ClientBundler.createAndBuild(
                    [ClientBundler.FileEntry.create('main', [entryPath])],
                    ClientBundler.Config.create({
                        outputPath,
                        workingDir: packageDir,
                        sourcemap: false
                    })
                )

                const built = bundler.currentRun.result.assetFor('main.bundle.js').content

                fs.writeFileSync(markerPath, "@fn marker(): string{\n    ???\n}\n")

                let error = null
                try{
                    await bundler.rebuild()
                } catch ( e ){
                    error = e
                }

                expect(error).not.toBeNull()
                expect(bundler.currentRun.result.assetFor('main.bundle.js').content).toBe(built)

                fs.writeFileSync(markerPath, "@fn marker(): string{\n    return 'marker:RECOVERED'\n}\n")
                await bundler.rebuild()

                const context = { window: {}, console, setTimeout, clearTimeout }
                vm.runInNewContext(bundler.currentRun.result.assetFor('main.bundle.js').content, context)
                expect(context.window.__probe__).toEqual(['marker:RECOVERED'])
            } finally {
                fs.writeFileSync(markerPath, markerSource)
                fs.rmSync(fixture.root, { recursive: true, force: true })
            }
        }
    }

    Scenario{
        name: 'concurrent rebuilds coalesce into a second run with its own state'
        run: async (expect) => {
            const bundler = await ClientBundler.create(
                [],
                ClientBundler.Config.create({
                    outputPath: '/tmp/client-bundler-scheduler',
                    workingDir: '/tmp',
                    sourcemap: false
                })
            )
            const resolvers = []
            // Deliberate stub: real builds would make scheduler assertions timing races.
            bundler._executeRun = () => new Promise((resolve) => {
                resolvers.push(resolve)
            })

            const first = bundler.rebuild()
            const second = bundler.rebuild()

            expect(resolvers.length).toBe(1)

            const firstState = { run: 1 }
            resolvers[0](firstState)
            expect(await first).toBe(firstState)

            expect(resolvers.length).toBe(2)

            const secondState = { run: 2 }
            resolvers[1](secondState)
            expect(await second).toBe(secondState)
        }
    }

    Scenario{
        name: 'disposing rejects a queued rebuild without starting it'
        run: async (expect) => {
            const bundler = await ClientBundler.create(
                [],
                ClientBundler.Config.create({
                    outputPath: '/tmp/client-bundler-scheduler-dispose',
                    workingDir: '/tmp',
                    sourcemap: false
                })
            )
            const resolvers = []
            // Deliberate stub: real builds would make scheduler assertions timing races.
            bundler._executeRun = () => new Promise((resolve) => {
                resolvers.push(resolve)
            })

            const first = bundler.rebuild()
            const second = bundler.rebuild()
            const queuedError = second.then(() => null, (error) => error)

            const disposal = bundler.dispose()
            const firstState = { run: 1 }
            resolvers[0](firstState)
            await disposal
            expect(await first).toBe(firstState)
            expect((await queuedError).message).toBe('ClientBundler has been disposed.')
            expect(resolvers.length).toBe(1)
        }
    }
}
