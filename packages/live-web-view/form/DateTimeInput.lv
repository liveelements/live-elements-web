import live-web.dom
import live-web.behavior
import live-web-view.button
import live-elements-web-server.view
import live-elements-web-server.style

component DateTimeInput < Div{
    id: dateTimeInput

    static any[] use = [
        ScopedStyle{ src: 'flatpickr/dist/flatpickr.min.css' },
        ScopedStyle{ src: './style/datetimeinput.css' process: '../style/CSSProcessor.lv' },
        ScopedStyle{ src: '../style/global.css' process: '../style/CSSProcessor.lv' } 
    ]

    string name
    string placeholder
    string value
    on valueChanged: () => { this.picker?.setDate(this.value || null, false) }

    boolean time: false
    boolean date: true
    boolean range: false

    Object options = ({})
    Object picker: null

    string currentValue: input.currentValue

    string[] extraClasses: []
    classes: this.extraClasses.concat([ScopedStyle.className(DateTimeInput)])

    Input{ 
        id: input
        type: 'text'
        name: dateTimeInput.name
        placeholder: dateTimeInput.placeholder
        value: dateTimeInput.value
    }


    DOMBehavior{
        domReady: async (d) => {
            if ( !window.__packages__ ){ window.__packages__ = {} }
            if ( !window.__packages__.flatpickr ){
                window.__packages__.flatpickr = (await import('flatpickr')).default
            }
            const flatpickr = window.__packages__.flatpickr

            
            const disableTime = (instance, disabled) => {
                if ( instance.hourElement ) instance.hourElement.disabled = disabled
                if ( instance.minuteElement ) instance.minuteElement.disabled = disabled
            }

            dateTimeInput.picker?.destroy()
            dateTimeInput.picker = flatpickr(d.querySelector('input'), {
                appendTo: d,
                position: "auto",
                static: true,
                enableTime: dateTimeInput.time,
                noCalendar: !dateTimeInput.date,
                mode: dateTimeInput.range ? 'range' : 'single',
                onReady: (selectedDates, dateStr, instance) => disableTime(instance, true),
                onOpen: (selectedDates, dateStr, instance) => disableTime(instance, false),
                onClose: (selectedDates, dateStr, instance) => disableTime(instance, true),
                ...dateTimeInput.options
            })
        }
    }
}